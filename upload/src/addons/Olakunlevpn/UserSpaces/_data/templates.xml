<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="olakunlevpn_user_space_edit" version_id="1000070" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('olakunlevpn_user_spaces_manage_my_space') }}</xf:title>

<xf:wrap template="account_wrapper" />

<xf:form action="{{ link('account/user-space/save') }}" ajax="true" upload="true" class="block" data-force-flash-message="true">
	<div class="block-container">
		<div class="block-body">
			<xf:formrow label="{{ phrase('olakunlevpn_user_spaces_public_urls') }}" explain="{{ phrase('olakunlevpn_user_spaces_public_urls_explain') }}">
				<div class="buttonGroup">
					<xf:button href="{{ link('u', $xf.visitor) }}" target="_blank" class="button--link">
						<xf:fa icon="fa-external-link-alt" /> {{ link('canonical:u', $xf.visitor) }}
					</xf:button>
				</div>
			</xf:formrow>

			<h2 class="block-formSectionHeader"><span class="block-formSectionHeader-aligner">{{ phrase('olakunlevpn_user_spaces_general_settings') }}</span></h2>

			<xf:textboxrow name="space_name" value="{$space.space_name}"
				label="{{ phrase('olakunlevpn_user_spaces_name') }}"
				explain="{{ phrase('olakunlevpn_user_spaces_name_explain') }}"
				placeholder="{$xf.visitor.username}"
				maxlength="100" />

			<xf:textarearow name="bio" value="{$space.bio}"
				label="{{ phrase('olakunlevpn_user_spaces_bio') }}"
				explain="{{ phrase('olakunlevpn_user_spaces_bio_explain') }}"
				rows="3"
				autosize="true"
				maxlength="500" />

			<h2 class="block-formSectionHeader"><span class="block-formSectionHeader-aligner">{{ phrase('olakunlevpn_user_spaces_branding_header') }}</span></h2>

			<xf:if is="$space.banner_path">
				<xf:formrow label="{{ phrase('olakunlevpn_user_spaces_current_banner') }}">
					<img src="{$space.banner_url}" style="max-width: 100%; max-height: 140px; border-radius: 4px; object-fit: cover;" /><br />
					<xf:checkbox standalone="true">
						<xf:option name="remove_banner" value="1" label="{{ phrase('olakunlevpn_user_spaces_delete_banner') }}" />
					</xf:checkbox>
				</xf:formrow>
			</xf:if>

			<xf:uploadrow name="banner" accept=".gif,.jpeg,.jpg,.png,.webp"
				label="{{ phrase('olakunlevpn_user_spaces_upload_banner') }}"
				explain="{{ phrase('olakunlevpn_user_spaces_upload_banner_explain') }}" />

			<xf:checkboxrow>
				<xf:option name="use_forum_avatar" value="1" selected="{$space.use_forum_avatar}"
					label="{{ phrase('olakunlevpn_user_spaces_use_forum_avatar') }}"
					explain="{{ phrase('olakunlevpn_user_spaces_use_forum_avatar_explain') }}" />
			</xf:checkboxrow>

			<xf:if is="$space.custom_logo_path">
				<xf:formrow label="{{ phrase('olakunlevpn_user_spaces_current_logo') }}">
					<img src="{$space.logo_url}" class="avatar avatar--m" alt="{$space.title}" /><br />
					<xf:checkbox standalone="true">
						<xf:option name="remove_logo" value="1" label="{{ phrase('olakunlevpn_user_spaces_delete_logo') }}" />
					</xf:checkbox>
				</xf:formrow>
			</xf:if>

			<xf:uploadrow name="custom_logo" accept=".gif,.jpeg,.jpg,.png,.webp"
				label="{{ phrase('olakunlevpn_user_spaces_upload_logo') }}"
				explain="{{ phrase('olakunlevpn_user_spaces_upload_logo_explain') }}" />

			<h2 class="block-formSectionHeader"><span class="block-formSectionHeader-aligner">{{ phrase('olakunlevpn_user_spaces_links_header') }}</span></h2>

			<xf:textboxrow name="link_1_title" value="{$space.link_1_title}"
				label="{{ phrase('olakunlevpn_user_spaces_link_1_title') }}"
				placeholder="{{ phrase('olakunlevpn_user_spaces_link_title_example1') }}"
				maxlength="100" />
			<xf:textboxrow name="link_1_url" value="{$space.link_1_url}"
				label="{{ phrase('olakunlevpn_user_spaces_link_1_url') }}"
				placeholder="https://..."
				type="url"
				maxlength="255" />

			<hr class="formRowSep" />

			<xf:textboxrow name="link_2_title" value="{$space.link_2_title}"
				label="{{ phrase('olakunlevpn_user_spaces_link_2_title') }}"
				placeholder="{{ phrase('olakunlevpn_user_spaces_link_title_example2') }}"
				maxlength="100" />
			<xf:textboxrow name="link_2_url" value="{$space.link_2_url}"
				label="{{ phrase('olakunlevpn_user_spaces_link_2_url') }}"
				placeholder="https://..."
				type="url"
				maxlength="255" />

			<hr class="formRowSep" />

			<xf:textboxrow name="link_3_title" value="{$space.link_3_title}"
				label="{{ phrase('olakunlevpn_user_spaces_link_3_title') }}"
				placeholder="{{ phrase('olakunlevpn_user_spaces_link_title_example3') }}"
				maxlength="100" />
			<xf:textboxrow name="link_3_url" value="{$space.link_3_url}"
				label="{{ phrase('olakunlevpn_user_spaces_link_3_url') }}"
				placeholder="https://..."
				type="url"
				maxlength="255" />
		</div>
		<xf:submitrow icon="save" />
	</div>
</xf:form>
]]></template>
  <template type="public" title="olakunlevpn_user_space_view" version_id="1000070" version_string="1.0.0"><![CDATA[<xf:title>{$space.title}</xf:title>
<xf:description>{$space.bio}</xf:description>

<xf:macro id="lightbox_macros::setup" arg-canViewAttachments="{$canViewAttachments}" />

<div class="block">
	<div class="block-container">
		<div class="block-body">
			<div class="memberHeader {{ $space.banner_url ? 'memberHeader--withBanner' : '' }}">
				<div class="memberHeader-main" style="{{ $space.banner_url ? 'background-image: url(\'' . $space.banner_url . '\');' : '' }}">
					<div class="memberHeader-mainContent">
						<span class="memberHeader-avatar">
							<span class="avatarWrapper">
								<xf:if is="$space.use_forum_avatar || !$space.logo_url">
									<xf:avatar user="{$user}" size="l" />
								<xf:else />
									<img src="{$space.logo_url}" class="avatar avatar--l" alt="{$space.title}" />
								</xf:if>
							</span>
						</span>
						<div class="memberHeader-content memberHeader-content--info">
							<xf:if is="$isOwner">
								<div class="memberHeader-actionTop">
									<div class="buttonGroup">
										<xf:button href="{{ link('account/user-space') }}" class="button--link">
											<xf:fa icon="fa-edit" /> {{ phrase('edit') }}
										</xf:button>
									</div>
								</div>
							</xf:if>

							<h1 class="memberHeader-name">
								<span class="memberHeader-nameWrapper">
									{$space.title}
								</span>
							</h1>

							<div class="memberHeader-blurbContainer">
								<div class="memberHeader-blurb">
									<xf:username user="{$user}" rich="true" />
								</div>

								<xf:if is="$space.bio">
									<div class="memberHeader-blurb">
										{$space.bio|nl2br}
									</div>
								</xf:if>

								<div class="memberHeader-blurb">
									<dl class="pairs pairs--inline">
										<dt>{{ phrase('olakunlevpn_user_spaces_views') }}</dt>
										<dd>{{ $space.total_views|number }}</dd>
									</dl>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<xf:if is="$space.valid_links is not empty">
	<div class="block">
		<div class="block-container">
			<div class="block-body">
				<xf:foreach loop="$space.valid_links" value="$link">
					<div class="block-row">
						<xf:button href="{{ link('u/click', $user, {'idx': $link.index}) }}"
							target="_blank" rel="noopener nofollow"
							class="button--cta button--fullWidth">
							<xf:fa icon="{$link.icon}" /> {$link.title}
						</xf:button>
					</div>
				</xf:foreach>
			</div>
		</div>
	</div>
</xf:if>

<div class="block block--messages"
	data-xf-init="lightbox inline-mod"
	data-type="profile_post"
	data-href="{{ link('inline-mod') }}">

	<div class="block-container">
		<div class="block-body js-replyNewMessageContainer">
			<xf:if is="$user.canPostOnProfile()">
				<xf:set var="$firstProfilePost" value="{$profilePosts|first}" />
				<xf:macro id="profile_post_macros::quick_post"
					arg-user="{$user}"
					arg-lastDate="{{ $firstProfilePost.post_date ?: 0 }}"
					arg-containerSelector="< .js-replyNewMessageContainer"
					arg-attachmentData="{$attachmentData}" />
			</xf:if>

			<xf:if is="$profilePosts is not empty">
				<xf:foreach loop="$profilePosts" value="$profilePost">
					<xf:macro id="profile_post_macros::{{ $profilePost.message_state == 'deleted' ? 'profile_post_deleted' : 'profile_post' }}"
						arg-attachmentData="{$profilePostAttachData.{$profilePost.profile_post_id}}"
						arg-profilePost="{$profilePost}" />
				</xf:foreach>
			<xf:else />
				<div class="block-row js-replyNoMessages">{{ phrase('there_no_messages_on_xs_profile_yet', {'name': $user.username}) }}</div>
			</xf:if>
		</div>
	</div>

	<xf:if is="$total > $perPage">
		<div class="block-outer block-outer--after">
			<xf:pagenav
				page="{$page}" perpage="{$perPage}" total="{$total}"
				link="u" data="{$user}"
				wrapperclass="block-outer-main" />
		</div>
	</xf:if>
</div>
]]></template>
</templates>
